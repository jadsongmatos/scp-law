{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "VITE_VOICE_GEN=1 vite build",
    "build:novoice": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:voices": "python3 -m scripts.generate.voices",
    "generate:images": "python3 -m scripts.generate.images",
    "generate:items": "python3 -m scripts.generate.items",
    "audit:backgrounds": "python3 -m scripts.audit.backgrounds",
    "audit:signage": "python3 -m scripts.audit.signage",
    "fix:overlaps": "python3 -m scripts.data.fix_overlaps",
    "merge:extracted": "python3 -m scripts.data.merge_extracted",
    "extract:positions": "python3 -m scripts.vision.extract_positions"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@google/genai": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^6.0.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-xtermjs": "file:./react-xtermjs",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "google-tts-api": "^2.0.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
